{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommitTypeAll(chore)"
  ],
  "semanticCommits": "enabled",
  "prConcurrentLimit": 2,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^jitpack\\.yml$/"
      ],
      "matchStrings": [
        "sdk (?:install|use) java (?<currentValue>[\\d.]+)-amzn"
      ],
      "depNameTemplate": "java",
      "datasourceTemplate": "java-version"
    }
  ],
  "packageRules": [
    {
      "groupName": "upgrade all non-major gradle dependencies",
      "matchManagers": [
        "gradle"
      ],
      "groupSlug": "gradle-all",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchPackageNames": [
        "*"
      ]
    }
  ]
}
